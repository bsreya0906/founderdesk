PORT=4000
# "memory" = throwaway in-memory MongoDB seeded with demo data (local dev only).
# For real data use a MongoDB Atlas URI: mongodb+srv://user:pass@cluster/founderdesk
MONGODB_URI=memory
# Shared secret: n8n and the Next.js proxy send this as the x-api-key header
API_KEY=change-me
# Comma-separated list of allowed browser origins (frontend URL)
CORS_ORIGIN=http://localhost:3000
# LLM: "mock" (no key needed), "anthropic" or "openai"
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
